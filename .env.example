# Local Ollama backend — imagery stays on-box (GDPR/BOS requirement)
OLLAMA_BASE_URL=http://localhost:11434
# Optional; only if your Ollama endpoint requires auth
OLLAMA_API_KEY=
# Optional remote Ollama Cloud base (defaults to https://ollama.com)
OLLAMA_CLOUD_BASE_URL=
# llama.cpp llama-server (OpenAI-compatible), e.g. llama-server -hf ggml-org/gemma-3-4b-it-GGUF
LLAMACPP_BASE_URL=http://localhost:8080
# Optional; only if llama-server was started with --api-key
LLAMACPP_API_KEY=
# Optional remote OpenRouter provider; disabled during operations
OPENROUTER_API_KEY=
